# Server
RSG_HOST=0.0.0.0
RSG_PORT=8765

# Optional team-only registration code.
# Leave blank to allow anyone who can reach the site to create an account.
# Set this before sharing the dashboard on your network.
RSG_REGISTRATION_CODE=

# Session lifetime in days.
RSG_SESSION_DAYS=14

# Keep false for normal local/LAN HTTP use.
# Set true only when the site is served through HTTPS.
RSG_COOKIE_SECURE=false

# Optional custom database path. Relative paths are resolved from the project folder.
RSG_DATABASE_PATH=data/rsg_dashboard.db
