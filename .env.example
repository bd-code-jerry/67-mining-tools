# Server
BD_HOST=127.0.0.1
BD_PORT=8765

# Required when BD_HOST is set to a non-local interface such as 0.0.0.0.
# Leave blank for localhost-only use.
BD_REGISTRATION_CODE=

# Session lifetime in days.
BD_SESSION_DAYS=14

# Keep false for normal local/LAN HTTP use.
# Set true only when the site is served through HTTPS.
BD_COOKIE_SECURE=false

# Optional custom database path. Relative paths are resolved from the project folder.
BD_DATABASE_PATH=data/bd_dashboard.db
